# 依赖与运行时（体积大，不进仓库）
node_modules/
dist/

# 发布用的压缩包（107 MB，传 Releases 而不是进 git）
release/

# 构建 / 测试的中间产物
.cache/
.build-tmp*/
.pkg-data/
.smoke-data/
.e2e-data/
.e2e-models-data/
.uicheck-data/
dist/.data-stash/
startup-log.txt
启动日志.txt
*.log

# 图标构建日志（图标本身 assets/icon.ico、icon.png 要提交）
assets/_icon-build.log
assets/_icon.html

# Office 测试样本里来自第三方包的空白模板（版权归 python-docx / python-pptx，不进仓库）
# 其余样本是 make-office-fixtures.py 生成的，随仓库提交以便直接跑测试
test-fixtures/office/real-template.docx
test-fixtures/office/real-template.pptx
